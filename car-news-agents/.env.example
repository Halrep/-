# このファイルを .env としてコピーし、値を設定してください。
#   cp .env.example .env
# .env はコミットしないこと（.gitignore で除外されています）。

# Anthropic API（分析・執筆・校正の各エージェントが利用）
ANTHROPIC_API_KEY=

# X (Twitter) API v2 Bearer Token（有料プラン必要。未設定時はXからの収集をスキップします）
X_BEARER_TOKEN=

# YouTube Data API v3 のAPIキー（無料枠あり。Google Cloud Consoleで発行、OAuth不要）
# 未設定時はYouTubeコメントの収集をスキップします
YOUTUBE_API_KEY=

# note.com ログイン情報（未設定時は投稿をスキップし、ローカル保存のみ行います）
NOTE_EMAIL=
NOTE_PASSWORD=
