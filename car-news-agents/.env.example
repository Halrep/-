# このファイルを .env としてコピーし、値を設定してください。
#   cp .env.example .env
# .env はコミットしないこと（.gitignore で除外されています）。

# 分析・執筆・校正の各エージェントが使うLLM。どちらか一方でよい。
# 両方設定した場合はGeminiが優先される（config/config.yamlのllm.providerで明示指定も可）。

# Google Gemini API（無料枠あり）: https://aistudio.google.com/apikey で発行
GEMINI_API_KEY=

# Anthropic API（従量課金）: https://console.anthropic.com/settings/keys で発行
ANTHROPIC_API_KEY=

# X (Twitter) API v2 Bearer Token（有料プラン必要。未設定時はXからの収集をスキップします）
X_BEARER_TOKEN=

# YouTube Data API v3 のAPIキー（無料枠あり。Google Cloud Consoleで発行、OAuth不要）
# 未設定時はYouTubeコメントの収集をスキップします
YOUTUBE_API_KEY=

# note.com ログイン情報（未設定時は投稿をスキップし、ローカル保存のみ行います）
NOTE_EMAIL=
NOTE_PASSWORD=
