  /** 人物マスタの行として書ける形に整える（公開は既定 false ＝ 先生が選んで開ける） */
  function figureRows() {
    return FIGURES.map(function (f) {
      var row = {};
      C.COLS.FIGURES.forEach(function (col) { row[col] = ''; });
      for (var k in f) { if (C.COLS.FIGURES.indexOf(k) >= 0) row[k] = f[k]; }
      row['肖像_URL'] = '';
      row['公開'] = false;
      return row;
    });
  }

  return { figureRows: figureRows, COUNT: FIGURES.length };
